# ==============================================================================
# FasalX Timeline Service — Environment Variables Template
# ==============================================================================
# Copy this file: cp .env.example .env
# Fill in the real values. NEVER commit the actual .env file to version control.
# This file is safe to commit (it contains only dummy/example values).
# ==============================================================================


# ------------------------------------------------------------------------------
# ENVIRONMENT
# Selects the active config class in app/core/config.py.
# Options: development | testing | production
# ------------------------------------------------------------------------------
ENVIRONMENT=development


# ------------------------------------------------------------------------------
# SERVICE IDENTITY
# Displayed in the FastAPI OpenAPI docs (/docs).
# ------------------------------------------------------------------------------
PROJECT_NAME=FasalX Timeline Service
API_V1_STR=/api/v1


# ------------------------------------------------------------------------------
# MONGODB
# Must point to the same cluster as the backend service (shared fasalx DB).
# For local development, the MongoDB instance started by docker-compose is used.
# ------------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=fasalx

# --- Docker Compose (local multi-service) ---
# MONGO_URL=mongodb://mongodb:27017

# --- Atlas Example (Production) ---
# MONGO_URL=mongodb+srv://fasalx_prod_user:REPLACE_WITH_ATLAS_PASSWORD@cluster0.abcde.mongodb.net/
# MONGO_DB_NAME=fasalx


# ------------------------------------------------------------------------------
# REDIS
# Used for TWO purposes in this service:
#   1. Arq Job Queue: Background GDD recalculation tasks and daily cron jobs.
#   2. JWT Token Cache: Validated auth tokens are cached for 300s to reduce
#      network calls to the fasalx-auth service mesh.
# The Redis URL MUST match the one used by the Arq WorkerSettings in worker/tasks.py.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Docker Compose ---
# REDIS_URL=redis://redis:6379/0

# --- Production (Managed Redis) ---
# REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@your-redis-host.com:6380/0


# ------------------------------------------------------------------------------
# SERVICE MESH — Auth Service
# The internal URL of the fasalx-auth (backend) service.
# This service calls GET /api/v1/users/me on the auth service to validate JWTs.
# In Docker Compose: use the Docker service name (fasalx-auth).
# In Kubernetes/GKE: resolved via K8s service DNS (see cloud-manifest.yaml).
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8000

# --- Docker Compose ---
# AUTH_SERVICE_URL=http://fasalx-auth:8000

# --- Production (K8s Service DNS) ---
# AUTH_SERVICE_URL=http://fasalx-auth.fasalx-prod.svc.cluster.local:8000
