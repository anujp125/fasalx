# ==============================================================================
# FasalX Backend — Environment Variables Template
# ==============================================================================
# Copy this file: cp .env.example .env
# Fill in the real values. NEVER commit the actual .env file to version control.
# This file is safe to commit (it contains only dummy/example values).
# ==============================================================================


# ------------------------------------------------------------------------------
# ENVIRONMENT
# Selects the active config class in app/core/config.py.
# Options: development | testing | production
# ------------------------------------------------------------------------------
ENVIRONMENT=development


# ------------------------------------------------------------------------------
# SERVICE IDENTITY
# Displayed in the FastAPI OpenAPI docs (/docs) and health check responses.
# ------------------------------------------------------------------------------
PROJECT_NAME=FasalX Backend
VERSION=0.1.0
API_V1_STR=/api/v1


# ------------------------------------------------------------------------------
# MONGODB
# For local development: use the plain connection string below.
# For production (MongoDB Atlas): replace with the SRV URI from your Atlas dashboard.
#   Atlas URI format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# ------------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=fasalx

# --- Atlas Example (Production) ---
# MONGO_URL=mongodb+srv://fasalx_prod_user:REPLACE_WITH_ATLAS_PASSWORD@cluster0.abcde.mongodb.net/
# MONGO_DB_NAME=fasalx


# ------------------------------------------------------------------------------
# REDIS
# For local development: connect to a locally running Redis instance.
# For production: use a managed Redis service (e.g., Redis Cloud, Upstash).
# Format: redis://<host>:<port>/<db-index>
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Docker Compose (local multi-service) ---
# REDIS_URL=redis://redis:6379/0

# --- Production (Managed Redis) ---
# REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@your-redis-host.com:6380/0


# ------------------------------------------------------------------------------
# FIREBASE ADMIN SDK
# Download the service account key JSON from:
#   Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Place the downloaded file inside the backend/ directory and set the path here.
# On GCP (Cloud Run / GKE), leave this blank — ADC (Application Default Credentials)
# will be used automatically via GOOGLE_APPLICATION_CREDENTIALS.
# ------------------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# --- GCP (Application Default Credentials) ---
# Leave FIREBASE_CREDENTIALS_PATH unset and set:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/key.json


# ------------------------------------------------------------------------------
# EXTERNAL APIS
# DATA.GOV.IN — Mandi (Agricultural Market) Price Data
# Register at: https://data.gov.in/user/register
# Generate your API key in your profile dashboard.
# ------------------------------------------------------------------------------
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# GEMINI
# Used by /api/v1/chatbot/message.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE_NAME=Kore
GEMINI_DISEASE_FALLBACK_MODEL=gemini-2.5-flash
CHATBOT_AUDIO_MAX_UPLOAD_BYTES=10485760
CHATBOT_AUDIO_ALLOWED_CONTENT_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp3,audio/mp4,audio/webm,audio/ogg,audio/aac,audio/flac

# NOMINATIM GEOLOCATION
# Configure a user agent for Nominatim OpenStreetMap usage (required by their terms)
NOMINATIM_USER_AGENT=fasalx-backend/1.0 (anujpwr125@gmail.com)
